{
 "app": "shoeson",
 "display_name": "Shoes On",
 "target": "iphone_69",
 "copy_contract": "single-header-benefit-story-v3",
 "health_app": false,
 "market": {
  "category": "routine timers and time-blindness planners",
  "audience": "adults who run late because their time guesses run short, often with ADHD",
  "problem": "Routine timers count down the minutes you guessed, so a morning built on short guesses is late before it starts",
  "advantage": "Plans backward from the leave time with the time each step really takes this person, learned from Done taps, plus a live on-track status",
  "competitive_context": "Routine apps are checklists with timers; time-blindness apps visualise time. Few learn the gap between guessed and real time and move the start time for it",
  "search_intent": [
   "time blindness",
   "leave on time",
   "adhd routine",
   "morning routine"
  ],
  "proof_points": [
   {
    "claim": "Home shows Start 7:00 AM for an 8:15 leave, with a 30 min gap the guess leaves out",
    "source": "raw/01_home.png"
   },
   {
    "claim": "The run screen shows Breakfast, a countdown dial and 3 min behind",
    "source": "raw/03_run.png"
   },
   {
    "claim": "The summary shows each step's guess against the time it took",
    "source": "raw/04_summary.png"
   }
  ]
 },
 "capture_report": "raw/capture-report.json",
