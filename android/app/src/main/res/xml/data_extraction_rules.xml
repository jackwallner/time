<?xml version="1.0" encoding="utf-8"?>
<!-- Routines and timings stay on this device, as on iOS ("Everything stays on
     this iPhone"). Nothing is backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
