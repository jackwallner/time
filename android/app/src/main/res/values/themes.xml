<resources>
    <style name="Theme.ShoesOn" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_canvas</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="WidgetHeadline">
        <item name="android:layout_width">match_parent</item>
        <!-- Fixed height so long step names shrink to fit instead of cutting off. -->
        <item name="android:layout_height">40dp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">34sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">16sp</item>
        <item name="android:autoSizeMaxTextSize">34sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
